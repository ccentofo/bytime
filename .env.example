# =============================================================================
# CadenzPoint — Environment Variables (template). Copy to `.env` and fill in.
# NEVER commit a real .env. This file contains placeholders only.
# =============================================================================

# --- Database (single-tenant deployment) ---------------------------------
# Per-customer Postgres connection string. For the self-service control plane,
# each tenant has its own DATABASE_URL (see the control-plane blueprint).
DATABASE_URL=postgresql://user:password@localhost:5432/bytime

# --- Authentication (Auth.js v5) -----------------------------------------
# 32-byte random secret: `openssl rand -base64 32`
AUTH_SECRET=replace-with-openssl-rand-base64-32
# Public base URL of this deployment (used in emails and OAuth redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Encryption (TOTP secrets, recovery codes, tenant DB URLs) -----------
# 64-char hex key: `openssl rand -hex 32`. REQUIRED in production: the app refuses to encrypt/decrypt with a
# missing or non-hex key (no silent fallback). Must be identical across every environment that shares data.
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# --- Cron protection ------------------------------------------------------
# Shared secret sent as `x-cron-secret` by the scheduler. `openssl rand -hex 16`
CRON_SECRET=replace-with-random-cron-secret

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must be on a domain verified in Resend (cadenzpoint.com).
EMAIL_FROM="CadenzPoint <noreply@cadenzpoint.com>"

# --- Tenant lifecycle (feature-plan-terms-compliance-fixes.md §4.4) -------
# Founder digest recipient: the daily lifecycle cron emails this address whenever there is something
# to act on (unresolved alerts, workspaces ready or overdue for deletion, stuck deletions, notices
# pending > 24 h). Leave blank to disable the digest (a warning is logged; customer notices are
# unaffected). Set it in staging and production.
OPS_ALERT_EMAIL=

# Local development only: admin connection used to create/drop local tenant databases
# (provisioning without NEON_API_KEY, and tenant:delete). Defaults to CONTROL_PLANE_DATABASE_URL.
# DEV_TENANT_ADMIN_DATABASE_URL=

# --- Error monitoring (Sentry) -------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
# Optional override; defaults to 0.1 in production, 1 in dev.
SENTRY_TRACES_SAMPLE_RATE=
# Optional (build time): upload source maps so Sentry stack traces are readable. Without these the
# build still succeeds and errors are still reported, just with minified stack traces.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Content-Security-Policy ----------------------------------------------
# 'report-only' (default, safe — logs violations without breaking the page) or 'enforce'.
# Flip to 'enforce' only after a browser smoke test confirms zero CSP violations.
CSP_MODE=report-only

# --- OAuth connect flow (QuickBooks / Gusto) -------------------------------
# Signs the `state` param used to bind a tenant-subdomain OAuth connect request to the apex
# callback + the tenant's completion route (R2-9). Optional — falls back to AUTH_SECRET if
# unset, but a dedicated secret is recommended so rotating one doesn't invalidate the other.
# `openssl rand -base64 32`
OAUTH_STATE_SECRET=

# --- QuickBooks Online integration (optional) ----------------------------
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# 'sandbox' or 'production'
QBO_ENVIRONMENT=sandbox

# --- Gusto integration (optional) ----------------------------------------
GUSTO_CLIENT_ID=
GUSTO_CLIENT_SECRET=
# 'demo' or 'production'
GUSTO_ENVIRONMENT=demo

# --- Testing (integration tests) -----------------------------------------
# Points at a disposable Postgres; integration tests truncate data.
TEST_DATABASE_URL=postgresql://bytime:bytime_dev@localhost:5432/bytime_test
# Optional 2nd disposable DB — enables tenant-data-isolation.test.ts (skipped if unset).
TEST_DATABASE_URL_2=

# =============================================================================
# The variables below are NOT used yet — they are added by upcoming Tier 2
# blueprints. Listed here so the env contract is complete. Leave blank for now.
# =============================================================================

# --- Control plane / multi-tenancy (control-plane blueprint) -------------
# Registry DB tracking all tenants (slug -> encrypted tenant DATABASE_URL).
CONTROL_PLANE_DATABASE_URL=
# Apex domain for tenant subdomains. Tenants live at <slug>.<APP_ROOT_DOMAIN>
# (e.g. acme.cadenzpoint.com); the apex + www are reserved for marketing/signup.
APP_ROOT_DOMAIN=cadenzpoint.com
# Public version of the above — used in the signup form workspace URL hint (client-side).
NEXT_PUBLIC_APP_ROOT_DOMAIN=cadenzpoint.com

# --- Tenant provisioning (provisioning blueprint) ------------------------
# Neon API key — provisioning creates one Neon PROJECT per tenant (strongest isolation).
NEON_API_KEY=
# Region for every new tenant project — keep it in the same region as the control plane and the
# Vercel functions (Vercel's default iad1 = aws-us-east-1). Falls back to Neon's default if unset.
NEON_REGION_ID=aws-us-east-1
# NEON_PROJECT_ID is NOT needed for the project-per-tenant model (only the API key is).

# --- Billing (Stripe) (billing blueprint) --------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Stripe price IDs from your dashboard (test mode)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# --- Isolation diagnostics (OFF by default) -------------------------------
# When set, enables GET /api/_diag/whoami (returns only resolved slug + physical DB name) for the
# isolation stress test (scripts/stress-isolation.ts). Leave UNSET in normal production; set it only
# for a verification run, or keep a long random value and treat it as a secret. Never exposes row data.
DIAG_SECRET=
