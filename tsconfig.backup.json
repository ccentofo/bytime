{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": [
    "scripts/backup/**/*.ts",
    "src/lib/encryption.ts",
    "src/lib/tenant/direct-url.ts",
    "src/lib/tenant/backup-locks.ts",
    "src/lib/tenant/db-name.ts",
    "src/lib/tenant/lifecycle-config.ts",
    "src/lib/tenant/slug-rules.ts"
  ]
}
