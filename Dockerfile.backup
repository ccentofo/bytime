# syntax=docker/dockerfile:1
# The backup image (feature-plan-database-backups.md §6.2): one bundle, three commands (backup, audit, restore-test).
# It runs only in AWS (ECS Fargate, us-east-1). The build compiles code; it never connects to a database and holds no
# secrets. No npm code runs on the GitHub runner: npm runs only here, in the builder stage, with --ignore-scripts.

# ---- builder: exactly the bundle's inputs (U6 keeps scripts/backup/deploy-paths.txt equal to them) -------------------
FROM node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS builder
WORKDIR /build
# .npmrc carries the repo's npm settings (legacy-peer-deps, fetch retries; no secrets): without it npm ci fails ERESOLVE.
COPY package.json package-lock.json .npmrc ./
# Dev dependencies are needed (esbuild, the AWS SDK packages); npm ci installs them by default (U6 checks nothing omits them).
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY tsconfig.backup.json ./
COPY scripts/backup/ scripts/backup/
COPY src/lib/encryption.ts src/lib/encryption.ts
COPY src/lib/tenant/direct-url.ts src/lib/tenant/direct-url.ts
COPY src/lib/tenant/backup-locks.ts src/lib/tenant/backup-locks.ts
RUN npm run backup:bundle

# ---- runtime: node + PostgreSQL 16 client tools (PGDG) + the bundle only ------------------------------------------
FROM node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl; \
    install -d /usr/share/postgresql-common/pgdg; \
    curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc; \
    echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends postgresql-client-16; \
    apt-get purge -y --auto-remove curl; \
    rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /build/build/backup/backup.cjs /app/backup.cjs
USER node
# Build-time smoke test: every module loads and pg_dump / pg_restore are 16.x (default paths, no environment).
RUN ["node", "/app/backup.cjs", "--self-check"]
ENTRYPOINT ["node", "/app/backup.cjs"]
